{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/build-vercel.sh",
  "outputDirectory": ".jac/client/dist",
  "rewrites": [
    {
      "source": "/user/:path*",
      "destination": "https://backend-production-b394.up.railway.app/user/:path*"
    },
    {
      "source": "/walker/:path*",
      "destination": "https://backend-production-b394.up.railway.app/walker/:path*"
    },
    {
      "source": "/function/:path*",
      "destination": "https://backend-production-b394.up.railway.app/function/:path*"
    },
    {
      "source": "/cl/:path*",
      "destination": "https://backend-production-b394.up.railway.app/cl/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
